cask "agent-command" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/brettmostert/homebrew-tap/releases/download/agent-command-v#{version}/AgentCommand.zip"
  name "Agent Command"
  desc "Native app to run AI coding agents and terminals in panes, with live status"
  homepage "https://github.com/brettmostert/homebrew-tap"

  depends_on arch: :arm64
  # The app runs Homebrew's acmd: its daemon, hooks and speech engine.
  depends_on formula: "brettmostert/tap/acmd"
  depends_on macos: :tahoe

  app "Agent Command.app"
  # Runs before Homebrew moves the app, and clears the quarantine flag on the
  # staged copy: without that, macOS kills the app and removes it.
  installer script: {
    executable: "/bin/sh",
    args:       ["-c", '/usr/bin/xattr -dr com.apple.quarantine "$0"', "#{staged_path}/Agent Command.app"],
  }

  # acmd init: the hooks and the service, with acmd's path. A failure here
  # mustn't fail the install: the app offers setup on launch.
  postflight_steps do
    run "bin/acmd", args: ["init"], base: :homebrew_prefix, must_succeed: false
  end

  # Upgrades run this too. acmd keeps running: it's the formula's.
  uninstall quit: "com.brettmostert.agent-command"

  # Only zap removes the wake rule: uninstall runs on upgrades too, and
  # `acmd uninstall` removes it itself. acmd's sessions and settings are the
  # formula's: `acmd uninstall --keep-data=false` deletes them.
  zap delete: "/etc/sudoers.d/agent-command",
      trash:  [
        "~/Library/Caches/com.brettmostert.agent-command",
        "~/Library/Preferences/com.brettmostert.agent-command.plist",
        "~/Library/Saved Application State/com.brettmostert.agent-command.savedState",
      ]

  caveats <<~EOS
    Agent Command isn't notarized, so this install cleared macOS's quarantine flag
    for it. It runs acmd from the acmd formula, which it installed, and set up its
    Claude Code hooks and service. Run acmd to open it.

    To let scheduled jobs wake the Mac shortly before they run, run
    acmd schedule wake on (it asks for your password once).

    Upgrade with brew upgrade agent-command. Homebrew leaves acmd as it was,
    so the app upgrades it when it next opens.

    Uninstalling the app leaves acmd and its sessions running. To remove acmd too,
    run acmd uninstall, then brew uninstall acmd.
  EOS
end
